{
  "info": {
    "name": "Research Opportunity Portal API",
    "description": "API tests for creating, retrieving, updating, closing, and deleting research opportunities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "opportunityId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Create Opportunity 1",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/opportunities",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"AI Research Assistant\",\n  \"description\": \"Work on an artificial intelligence research project.\",\n  \"research_area\": \"Artificial Intelligence\",\n  \"faculty_name\": \"Dr. Ahmed\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Machine Learning\",\n  \"available_positions\": 2,\n  \"application_deadline\": \"2027-06-30\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Opportunity created successfully', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "let d = pm.response.json();",
              "if (d.id) pm.collectionVariables.set('opportunityId', d.id);",
              "else if (d.insertId) pm.collectionVariables.set('opportunityId', d.insertId);",
              "else if (d.opportunity && d.opportunity.id) pm.collectionVariables.set('opportunityId', d.opportunity.id);"
            ]
          }
        }
      ]
    },

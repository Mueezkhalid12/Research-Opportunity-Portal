      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Opportunity created successfully', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "let d = pm.response.json();",
              "if (d.id) pm.collectionVariables.set('opportunityId', d.id);",
              "else if (d.insertId) pm.collectionVariables.set('opportunityId', d.insertId);",
              "else if (d.opportunity && d.opportunity.id) pm.collectionVariables.set('opportunityId', d.opportunity.id);"
            ]
          }
        }
      ],
